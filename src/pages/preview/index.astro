---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Marquee from "../../components/Marquee.astro";
import Manifesto from "../../components/Manifesto.astro";
import Servicios from "../../components/Servicios.astro";
import Proceso from "../../components/Proceso.astro";
// import Reel from "../../components/Reel.astro"; // oculto temporalmente
import Estudio from "../../components/Estudio.astro";
import Contacto from "../../components/Contacto.astro";
import Footer from "../../components/Footer.astro";
---

<Base>
  <Header />
  <main>
    <Hero />
    <Marquee />
    <Manifesto />
    <Servicios />
    <Proceso />
    <Marquee variant="outline" items={["EVENTOS EN VIVO", "HABLEMOS DE TU EVENTO", "8888", "PRODUCTORA DE EVENTOS"]} />
    {/* <Reel /> — oculto temporalmente, no borrar */}
    <Estudio />
    <Contacto />
  </main>
  <Footer />
</Base>
