---
const artistas = [
  { name: "CYBER NOVA", genre: "Hyperpop · Electronic", year: "2022", img: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80" },
  { name: "VAINILLA NEÓN", genre: "Pop · R&B", year: "2023", img: "https://images.unsplash.com/photo-1571115764595-644a1f56a55c?w=800&q=80" },
  { name: "KIRA 808", genre: "Electronic · Producer", year: "2021", img: "https://images.unsplash.com/photo-1516280440614-37939bbacd81?w=800&q=80" },
  { name: "MAREA SUR", genre: "Indie · Rock", year: "2024", img: "https://images.unsplash.com/photo-1501612780327-45045538702b?w=800&q=80" },
  { name: "NULL/VOID", genre: "Industrial · Trap", year: "2023", img: "https://images.unsplash.com/photo-1485579149621-3123dd979885?w=800&q=80" },
  { name: "ÓRBITA 12", genre: "Synth-pop · Future-pop", year: "2024", img: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=800&q=80" },
];
---

<section
  id="roster"
  class="px-[var(--spacing-margin)] py-32 border-b border-[var(--color-outline-variant)] bg-[var(--color-surface-low)]"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16">
    <div class="md:col-span-3 text-mono-label text-[var(--color-outline)]">02 / Roster</div>
    <div class="md:col-span-9" data-reveal>
      <h2 class="text-headline-md uppercase">
        Artistas <span class="acid">en órbita.</span>
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-gutter" data-stagger>
    {artistas.map((a, i) => (
      <a
        href="#"
        class="group block relative overflow-hidden bg-black aspect-[3/4]"
        data-stagger-item
        data-cursor-hover
      >
        <img
          src={a.img}
          alt={a.name}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-700 ease-out opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent group-hover:from-black/60 transition-colors"></div>
        <div class="absolute top-4 left-4 right-4 flex justify-between text-mono-label text-white/70">
          <span>0{i + 1}</span>
          <span>{a.year}</span>
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-6">
          <div class="text-mono-label text-[var(--color-on-surface-variant)] mb-2 group-hover:acid transition-colors">{a.genre}</div>
          <h3 class="font-display text-2xl md:text-3xl uppercase font-bold leading-none group-hover:acid transition-colors">
            {a.name}
          </h3>
          <div class="mt-4 h-px bg-white/20 group-hover:bg-acid transition-colors"></div>
          <div class="mt-3 flex justify-between items-center">
            <span class="text-mono-label opacity-70">VER PERFIL</span>
            <span class="material-symbols-outlined text-base group-hover:translate-x-2 transition-transform">north_east</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
