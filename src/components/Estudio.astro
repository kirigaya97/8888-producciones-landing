---
const specs = [
  { k: "Sala A", v: "Live Room 60m²" },
  { k: "Monitoreo", v: "Genelec 8351B" },
  { k: "Consola", v: "SSL Origin 32" },
  { k: "Outboard", v: "Neve · API · UA" },
  { k: "DAWs", v: "Pro Tools · Ableton" },
  { k: "Acústica", v: "Tratamiento Vicoustic" },
];
---

<section
  id="estudio"
  class="relative px-[var(--spacing-margin)] py-32 border-b border-[var(--color-outline-variant)] overflow-hidden"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-3 text-mono-label text-[var(--color-outline)] mb-8 md:mb-0">
      03 / Estudio
    </div>

    <div class="md:col-span-5 space-y-8" data-reveal>
      <h2 class="text-headline-md uppercase">
        Estudio de <span class="acid italic font-editorial normal-case">grabación</span>.
      </h2>
      <p class="text-editorial-serif text-[var(--color-on-surface-variant)] max-w-md">
        Sala propia para grabar, mezclar y masterizar. La usamos con los artistas
        del roster y la abrimos a sesiones externas.
      </p>
      <a
        href="#contacto"
        class="inline-flex items-center gap-3 bg-acid text-black px-6 py-3 font-bold text-mono-label hover:bg-[var(--color-acid-dim)] transition-colors"
        data-cursor-hover
      >
        RESERVAR SESIÓN <span class="material-symbols-outlined text-base">north_east</span>
      </a>
    </div>

    <div class="md:col-span-4" data-reveal>
      <dl class="border-t border-[var(--color-outline-variant)]">
        {specs.map((s) => (
          <div class="flex justify-between border-b border-[var(--color-outline-variant)] py-4">
            <dt class="text-mono-label text-[var(--color-outline)]">{s.k}</dt>
            <dd class="text-mono-label text-on-surface text-right">{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- Studio image strip -->
  <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-gutter" data-stagger>
    {[
      "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=800&q=80",
      "https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?w=800&q=80",
      "https://images.unsplash.com/photo-1571974599782-87624638275c?w=800&q=80",
      "https://images.unsplash.com/photo-1487180144351-b8472da7d491?w=800&q=80",
    ].map((src) => (
      <div class="aspect-square overflow-hidden bg-black" data-stagger-item>
        <img
          src={src}
          loading="lazy"
          alt="Studio"
          class="w-full h-full object-cover grayscale hover:grayscale-0 hover:scale-110 transition-all duration-700"
        />
      </div>
    ))}
  </div>
</section>
