---
interface Props {
  items?: string[];
  variant?: "acid" | "outline";
}
const {
  items = [
    "EVENTOS EN VIVO",
    "MANAGEMENT DE ARTISTAS",
    "8888 PRODUCCIONES",
    "SHOWS · MÚSICA · CONTENIDO",
    "BUENOS AIRES",
  ],
  variant = "acid",
} = Astro.props;
const repeated = [...items, ...items, ...items, ...items];
---

<div
  class:list={[
    "w-full overflow-hidden border-y pt-6 pb-2",
    variant === "acid"
      ? "bg-acid text-black border-black"
      : "border-[var(--color-outline-variant)]",
  ]}
>
  <div class="marquee-track">
    {repeated.map((item) => (
      <span class="px-8 font-editorial text-[clamp(40px,7vw,96px)] leading-none whitespace-nowrap uppercase tracking-tight flex items-center gap-8">
        <span class="leading-none inline-block">{item}</span>
        <span class="text-[0.4em] leading-none inline-block -translate-y-[0.06em]">✱</span>
      </span>
    ))}
  </div>
</div>
