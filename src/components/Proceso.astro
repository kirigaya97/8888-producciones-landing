---
const etapas = [
  {
    n: "01",
    title: "Briefing",
    desc: "Entendemos la idea, la fecha y el presupuesto. Salís de la primera reunión con un plan y un número.",
  },
  {
    n: "02",
    title: "Producción",
    desc: "Armamos todo: artistas, escenario, sonido, iluminación y proveedores. Cronograma cerrado y plan B para cada punto.",
  },
  {
    n: "03",
    title: "Día del evento",
    desc: "Coordinamos y operamos en vivo. Vos disfrutás; nosotros nos ocupamos de que todo entre en tiempo.",
  },
  {
    n: "04",
    title: "Registro",
    desc: "Aftermovie, fotos y contenido para redes. El evento sigue rindiendo después de que terminó.",
  },
];
---

<section
  id="proceso"
  class="px-[var(--spacing-margin)] py-32 border-b border-[var(--color-outline-variant)] bg-[var(--color-surface-low)]"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16">
    <div class="md:col-span-3 text-mono-label text-[var(--color-outline)]">02 / Proceso</div>
    <div class="md:col-span-9" data-reveal>
      <h2 class="text-headline-md uppercase">
        De la idea <span class="acid italic font-editorial normal-case">al aplauso</span>.
      </h2>
      <p class="text-mono-label text-[var(--color-outline)] mt-4">Cuatro etapas. Cero sorpresas.</p>
    </div>
  </div>

  <div class="border-t border-[var(--color-outline-variant)]" data-stagger>
    {etapas.map((e) => (
      <article
        class="group grid grid-cols-1 md:grid-cols-12 gap-gutter items-start border-b border-[var(--color-outline-variant)] py-10 md:py-12"
        data-stagger-item
        data-cursor-hover
      >
        <div class="md:col-span-3 font-editorial acid text-6xl md:text-7xl leading-none mb-4 md:mb-0">
          {e.n}
        </div>
        <h3 class="md:col-span-4 text-headline-md uppercase group-hover:acid transition-colors mb-3 md:mb-0">
          {e.title}
        </h3>
        <p class="md:col-span-5 text-body-reg text-[var(--color-on-surface-variant)] max-w-md">
          {e.desc}
        </p>
      </article>
    ))}
  </div>
</section>
