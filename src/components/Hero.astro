---
const words = ["EL", "SHOW", "NO", "SE", "IMPROVISA"];
---

<section
  id="top"
  class="relative min-h-screen px-[var(--spacing-margin)] pt-28 pb-12 md:pt-32 md:pb-16 flex flex-col justify-between border-b border-[var(--color-outline-variant)] overflow-hidden"
>
  <!-- Top meta row -->
  <div class="flex justify-end text-mono-label">
    <span id="clock" class="acid">--:--:-- BUE</span>
  </div>

  <!-- Headline -->
  <div class="my-8 md:my-12 lg:my-0">
    <h1 class="text-headline-lg uppercase">
      <span class="hero-line">
        <span class="hero-word" style="--i: 0">EL</span>
        <span class="hero-word acid" style="--i: 1">SHOW</span>
      </span>
      <span class="hero-line">
        <span class="hero-word" style="--i: 2">NO</span>
        <span class="hero-word" style="--i: 3">SE</span>
      </span>
      <span class="hero-line">
        <span class="hero-word acid italic font-editorial" style="--i: 4">IMPROVISA.</span>
      </span>
    </h1>
  </div>

  <!-- Bottom row -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-end" data-reveal>
    <div class="md:col-span-5">
      <p class="text-editorial-serif text-[var(--color-on-surface-variant)] max-w-md">
        Productora de eventos y management de artistas en Buenos Aires.
        Pensamos y producimos <span class="acid italic">shows en vivo</span> —y todo
        el contenido que los rodea.
      </p>
    </div>
    <div class="hidden md:block md:col-span-3 md:col-start-7 text-mono-label text-[var(--color-outline)]">
      <div class="border-t border-[var(--color-outline-variant)] pt-3">SCROLL</div>
      <div class="mt-2 text-3xl acid font-display">↓</div>
    </div>
    <div class="md:col-span-3 flex md:block justify-between items-end md:text-right">
      <div class="text-mono-label text-[var(--color-outline)]">CLIENTES ACTIVOS</div>
      <div class="font-editorial acid text-5xl md:text-6xl md:mt-1 leading-none">24</div>
    </div>
  </div>

  <!-- Background number -->
  <div
    class="pointer-events-none absolute -bottom-16 -right-8 font-editorial text-[28vw] leading-none acid opacity-[0.04] select-none"
    aria-hidden="true"
  >
    8888
  </div>
</section>

<style>
  /* Override del line-height ajustado del headline-lg para que las letras
     (acentos, italic editorial) no se recorten arriba/abajo dentro del overflow:hidden. */
  h1.text-headline-lg {
    line-height: 1;
  }
  .hero-line {
    display: block;
    overflow: hidden;
    padding-top: 0.08em;
    padding-bottom: 0.14em;
  }
  .hero-word {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
    transition:
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s ease-out;
    transition-delay: calc(var(--i, 0) * 70ms + 150ms);
    will-change: transform;
    margin-right: 0.18em;
  }
  .hero-word:last-child {
    margin-right: 0;
  }
  /* Reveal — controlado por JS (con timeout de seguridad) */
  :global(.hero-show) .hero-word {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  function tickClock() {
    const el = document.getElementById("clock");
    if (!el) return;
    const d = new Date();
    const fmt = (n: number) => String(n).padStart(2, "0");
    el.textContent = `${fmt(d.getHours())}:${fmt(d.getMinutes())}:${fmt(d.getSeconds())} BUE`;
  }
  setInterval(tickClock, 1000);
  tickClock();

  let revealed = false;
  function showHero() {
    if (revealed) return;
    revealed = true;
    document.documentElement.classList.add("hero-show");
  }

  if (document.getElementById("loader")) {
    document.addEventListener("loader:done", showHero, { once: true });
  } else {
    requestAnimationFrame(showHero);
  }
  // Safety net: si por algún motivo el loader no dispara, revelar a los 6s
  setTimeout(showHero, 6000);
</script>
