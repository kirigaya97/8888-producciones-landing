---
const year = new Date().getFullYear();
---

<footer class="bg-black border-t-4 border-acid">
  <!-- Nav row -->
  <div class="px-[var(--spacing-margin)] pt-16 md:pt-20 pb-12">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-gutter">
      <div class="col-span-2 md:col-span-6 mb-8 md:mb-0">
        <div class="text-mono-label text-[var(--color-outline)] mb-3">8888 PRODUCCIONES</div>
        <p class="font-editorial text-2xl md:text-3xl text-on-surface max-w-md leading-tight">
          Productora de eventos y management de artistas en
          <span class="acid">Buenos Aires</span>.
        </p>
        <a
          href="mailto:hola@8888producciones.com"
          class="inline-block mt-6 font-display text-lg hover:acid transition-colors border-b border-[var(--color-outline-variant)] hover:border-acid"
          data-cursor-hover
        >
          hola@8888producciones.com →
        </a>
      </div>
      <div class="md:col-span-3">
        <div class="text-mono-label text-[var(--color-outline)] mb-3">NAVEGACIÓN</div>
        <ul class="space-y-1.5 font-display">
          <li><a href="#manifiesto" class="hover:acid transition-colors" data-cursor-hover>Manifiesto</a></li>
          <li><a href="#servicios" class="hover:acid transition-colors" data-cursor-hover>Servicios</a></li>
          <li><a href="#proceso" class="hover:acid transition-colors" data-cursor-hover>Proceso</a></li>
          {/* <li><a href="#reel" class="hover:acid transition-colors" data-cursor-hover>Reel</a></li> — oculto temporalmente */}
          <li><a href="#estudio" class="hover:acid transition-colors" data-cursor-hover>Estudio</a></li>
        </ul>
      </div>
      <div class="md:col-span-3">
        <div class="text-mono-label text-[var(--color-outline)] mb-3">REDES & LEGAL</div>
        <ul class="space-y-1.5 font-display">
          <li><a href="#" class="hover:acid transition-colors" data-cursor-hover>Instagram</a></li>
          <li><a href="#" class="hover:acid transition-colors" data-cursor-hover>Behance</a></li>
          <li><a href="#" class="hover:acid transition-colors" data-cursor-hover>Privacy</a></li>
          <li><a href="#" class="hover:acid transition-colors" data-cursor-hover>Terms</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Meta row -->
  <div class="px-[var(--spacing-margin)] py-6 border-t border-[var(--color-outline-variant)]">
    <div class="flex flex-col md:flex-row gap-3 md:gap-6 justify-between items-start md:items-center text-mono-label text-[var(--color-outline)]">
      <span>© {year} 8888 Producciones. Producimos para vos.</span>
      <span class="acid">V2.0_08</span>
      <span>
        Hecho en Argentina | <a
          href="https://ramstudio.com.ar"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:acid transition-colors"
          data-cursor-hover>RAM Studio</a>
      </span>
    </div>
  </div>
</footer>
