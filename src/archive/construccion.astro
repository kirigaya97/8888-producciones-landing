---
import "../styles/global.css";

const title = "8888 Producciones — Sitio en construcción";
const description = "Estamos construyendo algo grande. Volvé pronto.";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0e0e" />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="construction-body">
    <!-- Animated background grid -->
    <div class="bg-grid" aria-hidden="true"></div>

    <!-- Mouse-follow gradient blob -->
    <div class="blob" id="blob" aria-hidden="true"></div>

    <!-- Custom cursor -->
    <div class="cursor" id="cursor" aria-hidden="true">
      <span class="cursor-ring"></span>
      <span class="cursor-dot"></span>
    </div>

    <!-- Scanlines + grain -->
    <div class="scanlines" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <!-- Top status bar -->
    <header class="top-bar">
      <div class="status">
        <span class="dot"></span>
        <span class="text-mono-label">REC · EN VIVO</span>
      </div>
      <div class="text-mono-label timestamp" id="timestamp">--:--:--</div>
    </header>

    <main class="stage">
      <!-- Four 8s logo with sound bars -->
      <div class="logo-mark" aria-label="8888 Producciones">
        <!-- Left sound bars -->
        <svg class="wave wave-left" viewBox="0 0 240 200" aria-hidden="true">
          <g fill="currentColor">
            <rect class="bar b1" x="0"   y="80"  width="8" height="40" rx="2"/>
            <rect class="bar b2" x="20"  y="60"  width="8" height="80" rx="2"/>
            <rect class="bar b3" x="40"  y="30"  width="8" height="140" rx="2"/>
            <rect class="bar b4" x="60"  y="10"  width="8" height="180" rx="2"/>
            <rect class="bar b5" x="80"  y="0"   width="8" height="200" rx="2"/>
            <rect class="bar b6" x="100" y="20"  width="8" height="160" rx="2"/>
            <rect class="bar b7" x="120" y="40"  width="8" height="120" rx="2"/>
            <rect class="bar b8" x="140" y="60"  width="8" height="80" rx="2"/>
            <rect class="bar b9" x="160" y="40"  width="8" height="120" rx="2"/>
            <rect class="bar b10" x="180" y="70" width="8" height="60" rx="2"/>
            <rect class="bar b11" x="200" y="85" width="8" height="30" rx="2"/>
          </g>
        </svg>

        <!-- The four 8s -->
        <svg class="rings" viewBox="-15 -15 670 280" aria-hidden="true" overflow="visible">
          <g fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round">
            <g class="eight e1"><circle cx="80"  cy="75"  r="55"/><circle cx="80"  cy="185" r="55"/></g>
            <g class="eight e2"><circle cx="240" cy="75"  r="55"/><circle cx="240" cy="185" r="55"/></g>
            <g class="eight e3"><circle cx="400" cy="75"  r="55"/><circle cx="400" cy="185" r="55"/></g>
            <g class="eight e4"><circle cx="560" cy="75"  r="55"/><circle cx="560" cy="185" r="55"/></g>
          </g>
        </svg>

        <!-- Right sound bars (mirrored) -->
        <svg class="wave wave-right" viewBox="0 0 240 200" aria-hidden="true">
          <g fill="currentColor">
            <rect class="bar b11" x="0"   y="85" width="8" height="30" rx="2"/>
            <rect class="bar b10" x="20"  y="70" width="8" height="60" rx="2"/>
            <rect class="bar b9" x="40"  y="40" width="8" height="120" rx="2"/>
            <rect class="bar b8" x="60"  y="60" width="8" height="80" rx="2"/>
            <rect class="bar b7" x="80"  y="40" width="8" height="120" rx="2"/>
            <rect class="bar b6" x="100" y="20" width="8" height="160" rx="2"/>
            <rect class="bar b5" x="120" y="0"  width="8" height="200" rx="2"/>
            <rect class="bar b4" x="140" y="10" width="8" height="180" rx="2"/>
            <rect class="bar b3" x="160" y="30" width="8" height="140" rx="2"/>
            <rect class="bar b2" x="180" y="60" width="8" height="80" rx="2"/>
            <rect class="bar b1" x="200" y="80" width="8" height="40" rx="2"/>
          </g>
        </svg>
      </div>

      <p class="kicker text-mono-label">8888 · PRODUCTORA AUDIOVISUAL</p>

      <h1 class="glitch" data-text="SITIO EN CONSTRUCCIÓN">
        <span aria-hidden="true" class="glitch-layer l1">SITIO EN CONSTRUCCIÓN</span>
        <span aria-hidden="true" class="glitch-layer l2">SITIO EN CONSTRUCCIÓN</span>
        <span class="glitch-base">SITIO EN CONSTRUCCIÓN</span>
      </h1>

      <p class="lede">
        Estamos masterizando una nueva experiencia.<br/>
        <span class="acid">Música · Espectáculos · Contenidos.</span>
      </p>

      <div class="cta-row">
        <a class="btn" href="mailto:hola@8888producciones.com">
          <span>Reservá tu sesión</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </main>

    <!-- Marquee strip -->
    <div class="marquee-wrap" aria-hidden="true">
      <div class="marquee-track">
        <span>PRÓXIMAMENTE</span><span class="diamond">◆</span>
        <span>8888 PRODUCCIONES</span><span class="diamond">◆</span>
        <span>MÚSICA</span><span class="diamond">◆</span>
        <span>ESPECTÁCULOS</span><span class="diamond">◆</span>
        <span>CONTENIDOS</span><span class="diamond">◆</span>
        <span>PRODUCIMOS PARA VOS</span><span class="diamond">◆</span>
        <span>PRÓXIMAMENTE</span><span class="diamond">◆</span>
        <span>8888 PRODUCCIONES</span><span class="diamond">◆</span>
        <span>MÚSICA</span><span class="diamond">◆</span>
        <span>ESPECTÁCULOS</span><span class="diamond">◆</span>
        <span>CONTENIDOS</span><span class="diamond">◆</span>
        <span>PRODUCIMOS PARA VOS</span><span class="diamond">◆</span>
      </div>
    </div>

    <footer class="bottom-bar">
      <span class="text-mono-label">© 8888 — {new Date().getFullYear()}</span>
      <span class="text-mono-label">BUENOS AIRES · AR</span>
    </footer>

    <script>
      // Mouse-follow blob + custom cursor
      const blob = document.getElementById("blob");
      const cursor = document.getElementById("cursor");
      if (window.matchMedia("(hover: hover)").matches) {
        let bx = window.innerWidth / 2, by = window.innerHeight / 2;
        let tx = bx, ty = by;
        let cx = bx, cy = by;
        window.addEventListener("mousemove", (e) => { tx = e.clientX; ty = e.clientY; });

        // Cursor instantly tracks; ring lags slightly
        function loop() {
          bx += (tx - bx) * 0.08;
          by += (ty - by) * 0.08;
          cx += (tx - cx) * 0.28;
          cy += (ty - cy) * 0.28;
          if (blob) blob.style.transform = `translate(${bx}px, ${by}px) translate(-50%, -50%)`;
          if (cursor) cursor.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
          requestAnimationFrame(loop);
        }
        loop();

        if (cursor) {
          document.querySelectorAll("a, button, [data-cursor-hover]").forEach((el) => {
            el.addEventListener("mouseenter", () => cursor.classList.add("is-hover"));
            el.addEventListener("mouseleave", () => cursor.classList.remove("is-hover"));
          });
          window.addEventListener("mousedown", () => cursor.classList.add("is-down"));
          window.addEventListener("mouseup", () => cursor.classList.remove("is-down"));
          document.addEventListener("mouseleave", () => cursor.classList.add("is-out"));
          document.addEventListener("mouseenter", () => cursor.classList.remove("is-out"));
        }
      }

      // Live timestamp (UTC-3 Buenos Aires)
      const ts = document.getElementById("timestamp");
      function tick() {
        const d = new Date();
        const fmt = new Intl.DateTimeFormat("es-AR", {
          hour: "2-digit", minute: "2-digit", second: "2-digit",
          timeZone: "America/Argentina/Buenos_Aires", hour12: false,
        }).format(d);
        if (ts) ts.textContent = `BA · ${fmt}`;
      }
      tick();
      setInterval(tick, 1000);
    </script>

    <style is:global>
      :root {
        --acid: #b6f700;
        --acid-dim: #9fd800;
        --bg: #0a0a0a;
        --ink: #e5e2e1;
      }

      .construction-body {
        background: var(--bg);
        color: var(--ink);
        min-height: 100dvh;
        overflow-x: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        font-family: var(--font-body, "Inter", sans-serif);
      }

      /* === Background grid === */
      .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(182, 247, 0, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(182, 247, 0, 0.06) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
        pointer-events: none;
        z-index: 1;
        animation: gridShift 30s linear infinite;
      }
      @keyframes gridShift {
        from { background-position: 0 0, 0 0; }
        to   { background-position: 60px 60px, 60px 60px; }
      }

      /* === Mouse blob === */
      .blob {
        position: fixed;
        top: 0; left: 0;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(182, 247, 0, 0.18), transparent 60%);
        pointer-events: none;
        z-index: 2;
        filter: blur(40px);
        will-change: transform;
      }

      /* === Scanlines === */
      .scanlines {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9997;
        background: repeating-linear-gradient(
          to bottom,
          transparent 0,
          transparent 2px,
          rgba(0, 0, 0, 0.18) 3px,
          transparent 4px
        );
        mix-blend-mode: multiply;
        opacity: 0.4;
      }

      /* === Grain === */
      .grain {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9998;
        opacity: 0.07;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        animation: grainShift 0.6s steps(4) infinite;
      }
      @keyframes grainShift {
        0%   { transform: translate(0, 0); }
        25%  { transform: translate(-2%, 1%); }
        50%  { transform: translate(1%, -2%); }
        75%  { transform: translate(-1%, 2%); }
        100% { transform: translate(0, 0); }
      }

      /* === Top / bottom bars === */
      .top-bar, .bottom-bar {
        position: relative;
        z-index: 10;
        padding: 24px clamp(20px, 4vw, 48px);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .top-bar {
        border-bottom: 1px solid rgba(182, 247, 0, 0.18);
      }
      .bottom-bar {
        border-top: 1px solid rgba(182, 247, 0, 0.18);
      }
      .status {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .status .dot {
        width: 10px;
        height: 10px;
        background: #ff3636;
        border-radius: 50%;
        box-shadow: 0 0 12px #ff3636;
        animation: pulse 1.4s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: 0.4; transform: scale(0.85); }
      }
      .timestamp { color: var(--acid); }

      /* === Stage === */
      .stage {
        position: relative;
        z-index: 10;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 32px clamp(20px, 5vw, 64px);
        gap: 28px;
      }

      .logo-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(8px, 2vw, 24px);
        color: var(--acid);
        width: 100%;
        max-width: 900px;
        filter: drop-shadow(0 0 24px rgba(182, 247, 0, 0.35));
        animation: floaty 6s ease-in-out infinite;
      }
      .logo-mark svg { max-width: 100%; height: auto; }
      @keyframes floaty {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-6px); }
      }

      .wave {
        width: clamp(60px, 12vw, 140px);
        height: auto;
      }
      .rings {
        width: clamp(220px, 38vw, 440px);
        height: auto;
      }
      .eight { transform-origin: center; transform-box: fill-box; }
      .eight.e1 { animation: bob 2.4s ease-in-out infinite; }
      .eight.e2 { animation: bob 2.4s ease-in-out infinite 0.2s; }
      .eight.e3 { animation: bob 2.4s ease-in-out infinite 0.4s; }
      .eight.e4 { animation: bob 2.4s ease-in-out infinite 0.6s; }
      @keyframes bob {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-10px); }
      }

      .bar { transform-origin: center; transform-box: fill-box; }
      .wave .b1  { animation: barFlex 0.9s ease-in-out infinite; }
      .wave .b2  { animation: barFlex 1.1s ease-in-out infinite 0.05s; }
      .wave .b3  { animation: barFlex 0.8s ease-in-out infinite 0.10s; }
      .wave .b4  { animation: barFlex 1.0s ease-in-out infinite 0.15s; }
      .wave .b5  { animation: barFlex 0.7s ease-in-out infinite 0.20s; }
      .wave .b6  { animation: barFlex 1.2s ease-in-out infinite 0.25s; }
      .wave .b7  { animation: barFlex 0.9s ease-in-out infinite 0.30s; }
      .wave .b8  { animation: barFlex 1.1s ease-in-out infinite 0.35s; }
      .wave .b9  { animation: barFlex 0.85s ease-in-out infinite 0.40s; }
      .wave .b10 { animation: barFlex 1.0s ease-in-out infinite 0.45s; }
      .wave .b11 { animation: barFlex 0.95s ease-in-out infinite 0.50s; }
      @keyframes barFlex {
        0%, 100% { transform: scaleY(0.35); }
        50%      { transform: scaleY(1); }
      }

      .kicker {
        color: var(--acid);
        letter-spacing: 0.3em;
        opacity: 0;
        animation: fadeUp 0.8s 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* === Glitch headline === */
      .glitch {
        position: relative;
        font-family: var(--font-display, "Space Grotesk", sans-serif);
        font-weight: 700;
        font-size: clamp(30px, 7vw, 96px);
        line-height: 0.95;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        opacity: 0;
        animation: fadeUp 1s 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        max-width: 100%;
        word-break: break-word;
        overflow-wrap: anywhere;
        hyphens: auto;
      }
      .glitch-base { position: relative; z-index: 2; }
      .glitch-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .glitch-layer.l1 {
        color: var(--acid);
        mix-blend-mode: screen;
        animation: glitchA 3.6s infinite steps(1);
        clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
      }
      .glitch-layer.l2 {
        color: #ff3b8d;
        mix-blend-mode: screen;
        animation: glitchB 4.2s infinite steps(1);
        clip-path: polygon(0 55%, 100% 55%, 100% 100%, 0 100%);
      }
      @keyframes glitchA {
        0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
        93% { transform: translate(-3px, 1px); opacity: 0.9; }
        94% { transform: translate(2px, -2px); opacity: 0.7; }
        96% { transform: translate(-2px, 2px); opacity: 0.9; }
        98% { transform: translate(0, 0); opacity: 0; }
      }
      @keyframes glitchB {
        0%, 90%, 100% { transform: translate(0, 0); opacity: 0; }
        91% { transform: translate(3px, 0); opacity: 0.8; }
        93% { transform: translate(-2px, 1px); opacity: 0.6; }
        95% { transform: translate(2px, -1px); opacity: 0.8; }
        97% { transform: translate(0, 0); opacity: 0; }
      }

      .lede {
        font-family: var(--font-editorial, "Newsreader", serif);
        font-size: clamp(18px, 2vw, 26px);
        line-height: 1.5;
        max-width: 640px;
        color: rgba(229, 226, 225, 0.85);
        opacity: 0;
        animation: fadeUp 1s 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .lede .acid { color: var(--acid); font-style: italic; }

      /* === CTA === */
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        opacity: 0;
        animation: fadeUp 1s 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 28px;
        background: var(--acid);
        color: #000;
        font-family: var(--font-display, "Space Grotesk", sans-serif);
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        text-decoration: none;
        border: 1px solid var(--acid);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        position: relative;
        overflow: hidden;
      }
      .btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 0 var(--acid-dim);
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink);
        border-color: rgba(229, 226, 225, 0.35);
      }
      .btn-ghost:hover {
        background: rgba(182, 247, 0, 0.08);
        border-color: var(--acid);
        color: var(--acid);
        box-shadow: 6px 6px 0 0 rgba(182, 247, 0, 0.25);
      }

      /* === Marquee === */
      .marquee-wrap {
        position: relative;
        z-index: 10;
        overflow: hidden;
        border-top: 1px solid rgba(182, 247, 0, 0.18);
        border-bottom: 1px solid rgba(182, 247, 0, 0.18);
        background: rgba(182, 247, 0, 0.04);
        padding: 18px 0;
      }
      .marquee-track {
        display: flex;
        gap: 40px;
        width: max-content;
        animation: marquee 30s linear infinite;
        font-family: var(--font-display, "Space Grotesk", sans-serif);
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--ink);
        white-space: nowrap;
      }
      .marquee-track .diamond {
        color: var(--acid);
      }
      @keyframes marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      /* === Custom cursor === */
      .cursor {
        position: fixed;
        top: 0; left: 0;
        width: 40px;
        height: 40px;
        pointer-events: none;
        z-index: 10001;
        will-change: transform;
        mix-blend-mode: difference;
      }
      .cursor-ring,
      .cursor-dot {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 9999px;
      }
      .cursor-ring {
        width: 36px;
        height: 36px;
        border: 1.5px solid var(--acid);
        transition: width 0.25s ease, height 0.25s ease, border-color 0.2s ease, opacity 0.2s ease;
      }
      .cursor-dot {
        width: 6px;
        height: 6px;
        background: var(--acid);
      }
      .cursor.is-hover .cursor-ring {
        width: 64px;
        height: 64px;
        border-color: var(--acid);
        background: rgba(182, 247, 0, 0.12);
      }
      .cursor.is-down .cursor-ring {
        width: 24px;
        height: 24px;
      }
      .cursor.is-out { opacity: 0; }

      @media (hover: hover) and (pointer: fine) {
        .construction-body,
        .construction-body * { cursor: none !important; }
      }
      @media (hover: none), (pointer: coarse) {
        .cursor { display: none; }
      }

      @media (max-width: 640px) {
        .wave-left, .wave-right { display: none; }
        .stage {
          gap: 20px;
          padding: 24px 18px;
        }
        .top-bar, .bottom-bar {
          padding: 14px 18px;
          gap: 10px;
          flex-wrap: wrap;
        }
        .top-bar .text-mono-label,
        .bottom-bar .text-mono-label { font-size: 11px; }
        .rings { width: min(85vw, 360px); }
        .kicker { font-size: 11px; letter-spacing: 0.25em; }
        .lede { font-size: 17px; padding: 0 6px; }
        .btn { padding: 14px 22px; font-size: 13px; }
        .blob { width: 360px; height: 360px; opacity: 0.7; }
        .marquee-wrap { padding: 12px 0; }
        .marquee-track { font-size: 13px; letter-spacing: 0.2em; gap: 28px; }
      }
      @media (max-width: 380px) {
        .glitch { font-size: 28px; }
        .rings { width: 80vw; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </body>
</html>
